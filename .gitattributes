# Normalize all text files to LF in the repo, regardless of platform.
* text=auto eol=lf

# Explicit LF for source and config files.
*.ts        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binaries — never normalize.
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.tgz       binary
